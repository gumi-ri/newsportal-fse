{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"palette": [
				{ "slug": "brand", "color": "#0F4FE0", "name": "品牌蓝" },
				{ "slug": "brand-dark", "color": "#0A34A0", "name": "深蓝" },
				{ "slug": "brand-deep", "color": "#07256E", "name": "藏蓝" },
				{ "slug": "link", "color": "#2B6CF0", "name": "链接蓝" },
				{ "slug": "brand-100", "color": "#E7EFFF", "name": "浅蓝底" },
				{ "slug": "accent", "color": "#FAA433", "name": "点缀橙" },
				{ "slug": "accent-dark", "color": "#E08A10", "name": "深橙" },
				{ "slug": "accent-100", "color": "#FFF4E2", "name": "浅橙底" },
				{ "slug": "white", "color": "#FFFFFF", "name": "白色" },
				{ "slug": "ink", "color": "#1A1F28", "name": "正文" },
				{ "slug": "ink-2", "color": "#5A6472", "name": "次要文字" },
				{ "slug": "ink-3", "color": "#8B95A3", "name": "弱化文字" },
				{ "slug": "line", "color": "#E8ECF2", "name": "分隔线" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "base",
					"name": "正文",
					"fontFamily": "Arial, 'Hiragino Sans GB', 'Microsoft YaHei', '微软雅黑', Tahoma, Helvetica, STHeiti, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "12px", "name": "小" },
				{ "slug": "normal", "size": "14px", "name": "常规" },
				{ "slug": "medium", "size": "16px", "name": "中" },
				{ "slug": "large", "size": "18px", "name": "大" },
				{ "slug": "x-large", "size": "20px", "name": "特大" },
				{ "slug": "xx-large", "size": "24px", "name": "超大" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"],
			"spacingSizes": [
				{ "slug": "10", "size": "4px", "name": "1" },
				{ "slug": "20", "size": "8px", "name": "2" },
				{ "slug": "30", "size": "12px", "name": "3" },
				{ "slug": "40", "size": "16px", "name": "4" },
				{ "slug": "50", "size": "24px", "name": "5" },
				{ "slug": "60", "size": "32px", "name": "6" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#1A1F28"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--base)",
			"fontSize": "14px",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": { "text": "#1A1F28" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "#2B6CF0" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"color": { "text": "#1A1F28" },
				"typography": { "fontWeight": "700", "lineHeight": "1.4" }
			},
			"h1": { "typography": { "fontSize": "24px" } },
			"h2": { "typography": { "fontSize": "20px" } },
			"h3": { "typography": { "fontSize": "16px" } },
			"button": {
				"color": { "background": "#0F4FE0", "text": "#FFFFFF" },
				"border": { "radius": "0" },
				"typography": { "fontSize": "16px" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "32px", "fontWeight": "700" },
				"color": { "text": "#0F4FE0" },
				"elements": {
					"link": {
						"color": { "text": "#0F4FE0" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "#0A34A0" }, "typography": { "textDecoration": "none" } }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "14px", "fontWeight": "700" }
			},
			"core/post-title": {
				"typography": { "fontSize": "16px", "fontWeight": "400", "lineHeight": "1.5" },
				"elements": {
					"link": {
						"color": { "text": "#222222" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "#2E61BF" }, "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "#999999" },
				"typography": { "fontSize": "12px" }
			},
			"core/post-terms": {
				"color": { "text": "#999999" },
				"typography": { "fontSize": "12px" }
			},
			"core/query-title": {
				"typography": { "fontSize": "20px", "fontWeight": "700" }
			}
		},
		"spacing": {
			"blockGap": "0"
		}
	}
}
